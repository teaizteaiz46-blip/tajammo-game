-<body>
-<div class="wrap" id="app"></div>
-
-<script>
-/* ============================ CATEGORY QUESTION BANK (Supabase) ============================ */
-/* كل موضوع فيه ٥ أسئلة سهلة (١٠٠ نقطة) و٥ أسئلة متوسطة (٢٠٠ نقطة)، محمّلة من قاعدة بيانات أونلاين.
-   كل لعبة تختار عشوائياً ٢ من كل مستوى، وتتجنب تكرار نفس الأسئلة قبل ما تخلص كل الأسئلة المتوفرة. */
-let CATEGORY_TOPICS = [];   // ['جغرافيا', 'تاريخ', ...] يُملى بعد التحميل
-let CATEGORY_DATA = {};     // { 'جغرافيا': { easy:[{text,answer}], medium:[{text,answer}] } }
-const bankUsage = {};       // { topicName: { easy:Set, medium:Set } }, in-memory rotation tracker
-
-async function loadCategoryDatabase(){
-  const { data, error } = await sb
-    .from('category_questions')
-    .select('topic, points, question, answer')
-    .limit(2000);
-  if(error) throw error;
-  const grouped = {};
-  data.forEach(row=>{
-    if(!grouped[row.topic]) grouped[row.topic] = { easy:[], medium:[] };
-    const tier = row.points <= 100 ? 'easy' : 'medium';
-    grouped[row.topic][tier].push({ text:row.question, answer:row.answer });
-  });
-  CATEGORY_DATA = grouped;
-  CATEGORY_TOPICS = Object.keys(grouped);
-}
-
-function shuffled(arr){
-  const a = arr.slice();
-  for(let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
-  return a;
-}
-function pickFromTier(tier, usedSet, n){
-  let avail = tier.map((_,i)=>i).filter(i=>!usedSet.has(i));
-  if(avail.length < n){ usedSet.clear(); avail = tier.map((_,i)=>i); }
-  const chosen = shuffled(avail).slice(0,n);
-  chosen.forEach(i=>usedSet.add(i));
-  return chosen.map(i=>tier[i]);
-}
-function pickQuestionsForBankTopic(topicName){
-  if(!bankUsage[topicName]) bankUsage[topicName] = { easy:new Set(), medium:new Set() };
