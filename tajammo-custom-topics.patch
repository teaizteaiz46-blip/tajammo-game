-  const eligible = shdEligibleChancellors();
-  const grid = el(`<div class="pick-grid"></div>`);
-  state.shdPlayers.forEach((p, i)=>{
-    const ok = eligible.includes(i);
-    const card = el(`<div class="pick-card ${ok?'':'taken'}">${escapeAttr(p.name)}</div>`);
