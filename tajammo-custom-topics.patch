-async function fetchRandomCharacters(n){
-  const { data, error } = await sb
-    .from('whoami_characters')
-    .select('name')
-    .limit(500);
-  if(error) throw error;
-  const shuffled = data.map(r=>r.name).sort(()=> Math.random()-0.5);
